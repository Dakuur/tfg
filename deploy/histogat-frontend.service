[Unit]
Description=HistoGAT Web Frontend
Documentation=https://github.com/Dakuur/tfg
After=network.target
Wants=network.target

[Service]
Type=simple
User=DEPLOY_USER
Group=DEPLOY_GROUP
WorkingDirectory=DEPLOY_DIR

ExecStart=DEPLOY_DIR/venv/bin/uvicorn frontend.main:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 1 \
    --log-level info

Restart=always
RestartSec=5
TimeoutStartSec=30

# Logs via journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=histogat-frontend

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
